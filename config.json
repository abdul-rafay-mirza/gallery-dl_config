{
    "extractor": {
        "base-directory": "./",
        "cookies-from-browser": "librewolf",

        "twitter": {
            "directory": [""],
            "filename": "_by_@{author[name]}.{extension}" 
        },
        "pixiv": {
            "directory": [""],
            "filename": "{title}_by_{user[account]}.{extension}"
        },
        "danbooru": {
            "directory": [""],
            "filename": "{character:J_-_/}_{general:J_-_/}_by_{artist:J_-_/}.{extension}"
        },

        "postprocessors": [
            {
                "name"   : "exec",
                "async"  : false,
                "command": ["figlet", "done!"],
                "event"  : "after"
            },
            {
                "name": "exec",
                "command": [
                    "exiftool", 
                    "-overwrite_original", 
                    "-charset", "filename=UTF8",
                    "-Artist={_extr.url}",
                    "-XPAuthor={_extr.url}",
                    "-XMP:Creator={_extr.url}",
                    "{_path}"
                ],
                "event": "after"
            }
        ]
    }
}
